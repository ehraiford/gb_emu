{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run debug",
            "type": "shell",
            "command": "cargo run",
            "options": {
                "cwd": "gb_emu",
                "env": {
                    "RUST_BACKTRACE": "1"
                }
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "run release",
            "type": "shell",
            "command": "cargo run --release",
            "options": {
                "cwd": "gb_emu",
                "env": {
                    "RUST_BACKTRACE": "1"
                }
            },
            "problemMatcher": "$rustc"
        }
    ]
}