{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run debug Dr. Mario",
            "type": "shell",
            "command": "cargo run --  run --tile-map-viewer ${workspaceFolder}/test_roms/'Dr. Mario.gb'",
            "options": {
                "env": {
                    "RUST_BACKTRACE": "1"
                }
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "run Dr. Mario",
            "type": "shell",
            "command": "cargo run --release --  run --tile-map-viewer ${workspaceFolder}/test_roms/'Dr. Mario.gb'",
            "options": {
                "env": {
                    "RUST_BACKTRACE": "1"
                }
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "run Tetris",
            "type": "shell",
            "command": "cargo run --release -- run --tile-map-viewer ${workspaceFolder}/test_roms/Tetris.gb",
            "options": {
                "env": {
                    "RUST_BACKTRACE": "1"
                }
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "run Mario Land",
            "type": "shell",
            "command": "cargo run --release -- run --tile-map-viewer '${workspaceFolder}/test_roms/Super Mario Land.gb'",
            "options": {
                "env": {
                    "RUST_BACKTRACE": "1"
                }
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "Run Tests Headless",
            "type": "shell",
            "command": "cargo test --features headless",
            "options": {
                "env": {
                    "RUST_BACKTRACE": "1"
                }
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "run Blargg Test Interrupt Instrs",
            "type": "shell",
            "command": "cargo run --release -- run-as-fast-as-possible ${workspaceFolder}/test_roms/blargg_test_roms/02-interrupts.gb",
            "options": {
                "env": {
                    "RUST_BACKTRACE": "1"
                }
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "run Blargg Test OP A HL",
            "type": "shell",
            "command": "cargo run --release -- run-as-fast-as-possible ${workspaceFolder}/test_roms/'blargg_test_roms/11-op a,(hl).gb'",
            "options": {
                "env": {
                    "RUST_BACKTRACE": "1"
                }
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "run Blargg Test OAM BUG",
            "type": "shell",
            "command": "cargo run --release -- run-as-fast-as-possible ${workspaceFolder}/test_roms/blargg_test_roms/oam/1-lcd_sync.gb",
            "options": {
                "env": {
                    "RUST_BACKTRACE": "1"
                }
            },
            "problemMatcher": "$rustc"
        },
    ]
}