{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run debug Dr. Mario",
            "type": "shell",
            "command": "cargo run --  run --tile-map-viewer ${workspaceFolder}/test_roms/'Dr. Mario.gb'",
            "options": {
                "cwd": "gb_emu",
                "env": {
                    "RUST_BACKTRACE": "1"
                }
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "run Dr. Mario",
            "type": "shell",
            "command": "cargo run --release --  run --tile-map-viewer ${workspaceFolder}/test_roms/'Dr. Mario.gb'",
            "options": {
                "cwd": "gb_emu",
                "env": {
                    "RUST_BACKTRACE": "1"
                }
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "run Tetris",
            "type": "shell",
            "command": "cargo run --release -- run --tile-map-viewer ${workspaceFolder}/test_roms/Tetris.gb",
            "options": {
                "cwd": "gb_emu",
                "env": {
                    "RUST_BACKTRACE": "1"
                }
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "Run Tests Headless",
            "type": "shell",
            "command": "cargo test --features headless",
            "options": {
                "cwd": "gb_emu",
                "env": {
                    "RUST_BACKTRACE": "1"
                }
            },
            "problemMatcher": "$rustc"
        }
    ]
}